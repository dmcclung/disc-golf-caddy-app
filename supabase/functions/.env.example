# Copy to supabase/functions/.env for `supabase functions serve`,
# and set in production with: supabase secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...
# RevenueCat API v2 secret key with only Customer information > Customers: Read only.
# Used to confirm a purchase before the webhook lands.
REVENUECAT_SECRET_API_KEY=sk_...
# Project settings > General (the id in dashboard URLs, e.g. proj1ab2c3d4)
REVENUECAT_PROJECT_ID=proj...
# Product catalog > Entitlements > pro: the internal id (entl...), not the "pro" identifier
REVENUECAT_PRO_ENTITLEMENT_INTERNAL_ID=entl...
# RevenueCat webhook HMAC signing secret (Integrations > Webhooks; shown once when enabled or rotated).
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=pro
FREE_ANALYSES=3
PRO_DAILY_LIMIT=30
