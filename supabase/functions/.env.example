# Copy to supabase/functions/.env for `supabase functions serve`,
# and set in production with: supabase secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...
# RevenueCat secret (v1) API key: used to confirm a purchase before the webhook lands.
REVENUECAT_SECRET_API_KEY=sk_...
# Any long random string; paste the same value into the RevenueCat webhook Authorization header.
REVENUECAT_WEBHOOK_AUTH=change-me
REVENUECAT_ENTITLEMENT_ID=pro
FREE_ANALYSES=3
PRO_DAILY_LIMIT=30
